APP_NAME=base-service
APP_ENV=prod

GRPC_PORT=50051

DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/base-service
DATABASE_DIRECT_URL=postgresql://postgres:postgres@postgres:5432/base-service

ACCESS_SECRET=your_access_secret

PG_BOSS_MAX=5
PG_BOSS_MAINTENANCE_INTERVAL_SECONDS=60
PG_BOSS_APPLICATION_NAME=base-service-pg-boss

KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=base-service-client
KAFKA_GROUP_ID=base-service-service
