APP_NAME=service-template
APP_ENV=prod

GRPC_PORT=50051

DATABASE_URL=postgresql://postgres:postgres@pgbouncer:6432/service-template
DATABASE_DIRECT_URL=postgresql://postgres:postgres@postgres:5432/service-template

ACCESS_SECRET=your_access_secret

PG_BOSS_MAX=5
PG_BOSS_MAINTENANCE_INTERVAL_SECONDS=60
PG_BOSS_APPLICATION_NAME=service-template-pg-boss

KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=service-template-client
KAFKA_GROUP_ID=service-template-service
