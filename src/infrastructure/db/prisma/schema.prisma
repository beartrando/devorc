generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

model BaseService {
  id         String @id @default(uuid())
  userId     String @unique @map("user_id")
  nickname   String @default("guest")
  level      Int    @default(1)
  rating     Int    @default(1000)
  experience Int    @default(0)

  achievements BaseServiceAchievement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("base-services")
}

model BaseServiceAchievement {
  id            String @id @default(uuid())
  base-serviceId     String @map("base-service_id")
  achievementId String @map("achievement_id")

  base-service     BaseService     @relation(fields: [base-serviceId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([base-serviceId, achievementId])
  @@map("base-service_achievements")
}

model Achievement {
  id          String  @id @default(uuid())
  title       String  @unique
  description String?

  base-services BaseServiceAchievement[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("achievements")
}

model ExperienceLevel {
  level        Int @id
  nextRequired Int @map("next_required")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("experience_levels")
}
